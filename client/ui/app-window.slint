import { VerticalBox, Button, Palette } from "std-widgets.slint";
import { CardsDisplay } from "cards-display.slint";
import { CardSuitSlint, CardRankSlint, CardSlint, PlayerSlint, AppState } from "structs.slint";
import { HomeScreen } from "home-screen.slint";
import { PlayersDisplay } from "player-display.slint";
import { PendingGame } from "pending-game-screen.slint";
import { TableCardsDisplay } from "table-display.slint";
import { Hotbar } from "hotbar.slint";

export component MainWindow inherits Window {
    callback play_card(card: CardSlint);
    callback set_position(from: int, to: int);
    callback submit_name(name: string);
    callback join_game;
    callback add_npc;
    callback pass;
    callback bid_further;
    callback selected_trump(suit: CardSuitSlint);
    
    in property <string> name;
    in property <string> game_value: "0";
    in property <CardSuitSlint> game_trump: CardSuitSlint.none;
    in-out property <bool> my_turn: false;
    in-out property <bool> solo: false;
    in-out property <bool> select_trump: false;
    in-out property <[CardSlint]> hand;
    in-out property <[CardSlint]> table_cards;
    in-out property <AppState> app_state;
    in-out property <[PlayerSlint]> players;

    Rectangle {
        background: @radial-gradient(circle, #007400 0%, #004400 100%);
    }

    Rectangle {
        height: 100px;
        width: 100px;
        x: 0;
        y: 0;
        background: rgb(255, 0, 0);
        transform-rotation: 45deg;
        transform-origin: {x: self.width / 2, y: self.height / 2};
    }

    if (app_state == AppState.Game) : HorizontalLayout {
        alignment: center;
        TableCardsDisplay { 
            cards: root.table_cards; 
            card_width: root.width / 3;
            y: root.height * 20%;
        }
    }

    if (app_state == AppState.Game || app_state == AppState.Bid) : CardsDisplay { 
        hand: hand;
        play_card(card) => { 
            if(app_state == AppState.Game && my_turn) {
                my_turn = false;
                root.play_card(card); 
            }
        }
        set_position(from, to) => { root.set_position(from, to); }
    } 

    if (app_state == AppState.Game || app_state == AppState.Bid) : Hotbar {
        height: parent.height * 15%;
        y: parent.y + parent.height - self.height;
        pass => {
            my_turn = false; 
            root.pass();
        }
        bid_further => { root.bid_further(); }
        selected_trump(suit) => { 
            root.selected_trump(suit); 
            root.select_trump = false;
        }
        app_state: root.app_state;
        game_value: root.game_value;
        select_trump: root.select_trump;
        game_trump: root.game_trump;
    }

    if (app_state == AppState.Lobby || app_state == AppState.Login) : HomeScreen {
        clicked => { root.join_game(); }
    }

    if (app_state == AppState.PendingGame) : PendingGame {
        add_npc => { root.add_npc(); }
    }

    if (app_state != AppState.Login) : PlayersDisplay {
        x: 0;
        y: 0;
        width: max(root.width * 30%, 200px);
        players: root.players;
        self-name: root.name;
    }

    property <string> input_text: "";

    if (app_state == AppState.Login) : Rectangle {
        width: 70%;
        height: 40%;
        border-radius: 10px;
        border-color: rgb(200, 200, 200);
        background: Palette.background;
        drop-shadow-blur:  5px;
        drop-shadow-color: rgba(0, 0, 0, 0.2);
        drop-shadow-offset-x: 5px;
        drop-shadow-offset-y: 5px;

        VerticalBox {
            x: parent.width * 10%;
            y: parent.height * 20%;
            width: 80%;
            height: 40px;

            input := TextInput { 
               color: Palette.control-foreground;
                edited => {
                    root.input_text = self.text;
                }
            }
        }

        Text {
            x: parent.width * 10% + 7px;
            y: parent.height * 20% + 9px;
            text: "enter name";
            color: rgb(150, 150, 150);
            visible: root.input_text == "";
        }

        Button {
            x: parent.width * 10%;
            y: parent.height * 60%;
            width: 80%;
            height: 20%;
            text: "OK";
            clicked => root.submit_name(input.text);
        }
    }
}
